TEACHER_USERNAME=teacher
# TEACHER_DISPLAY_NAME=林老師
TEACHER_PASSWORD=replace-with-teacher-password
# 選填：Google 服務帳戶 JSON 檔案路徑；可使用相對於專案根目錄的路徑。本機 XLSX 匯入不需要。
# GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json
# PORT=3000

# 區網測試可設定 HOST=0.0.0.0，預設只監聽本機。
# HOST=0.0.0.0

# AI 備題（選填），模型名稱依服務提供者設定。
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=
# AI_API_KEY=
